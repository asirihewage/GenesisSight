# ---------------------------------------------------------------------------
# Local AI CCTV Analyzer — configuration
# Copy to .env and adjust. All values are optional (defaults shown).
# ---------------------------------------------------------------------------

# --- service ---
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_PORT=3000
LOG_LEVEL=INFO

# --- storage / database ---
STORAGE_DIR=storage
# SQLite (default). PostgreSQL-compatible schema — switch by changing URL:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/cctv
MAX_UPLOAD_MB=2048

# --- models ---
MODEL_DIR=models
YOLO_MODEL=yolo11x.pt
DEVICE=auto            # auto | cuda:0 | cpu
YOLO_CONF=0.30
YOLO_IMG_SIZE=1280

# Person re-identification
#   osnet    -> OSNet x1_0 via torchreid (best; needs weights file + pip install torchreid)
#   resnet   -> ResNet50 ImageNet embeddings (real, works out of the box)
#   disabled -> identity = track id (no cross-track matching)
REID_ENGINE=osnet
REID_WEIGHTS=models/osnet_x1_0_imagenet.pth
REID_MATCH_THRESHOLD=0.70

# --- pipeline ---
TARGET_FPS=3.0              # processing sampling rate (frames processed per second of video)
MOTION_THRESHOLD=0.0025
DETECT_BATCH_SIZE=8         # frames per YOLO forward pass
REID_REFRESH_INTERVAL=25
VLM_ENABLED=true
VLM_MAX_EVENTS=40           # keyframes sent to Qwen2.5-VL per video
VLM_CONFIDENCE_MIN=0.3

# --- ollama (local LLM) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_VLM_MODEL=qwen2.5vl:7b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_S=180
