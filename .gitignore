# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Env / secrets
.env

# Models (large, downloaded on first use)
models/*.pt
models/*.pth

# Storage (uploads, frames, database)
storage/uploads/*
storage/frames/*
storage/images/*
storage/database/*
!storage/database/.gitkeep
storage/*.avi

# Frontend / Electron
frontend/node_modules/
frontend/dist/
electron/node_modules/
electron/dist/

# Logs / temp build files
*.log
pip-install*.log

# Generated at build time (python build_exe.py)
backend/app/__main__.py

# Build artifacts
build/
dist-exe/
*.spec
release/

# electron app icon lives in electron/build/
!electron/build/
!electron/build/icon.ico
!electron/build/icon.png

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# TS build info
*.tsbuildinfo
